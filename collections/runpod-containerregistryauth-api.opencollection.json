{
  "opencollection": "1.0.0",
  "info": {
    "name": "Runpod REST Billing Containerregistryauth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Containerregistryauth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List container registry auth entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
