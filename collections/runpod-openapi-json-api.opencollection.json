{
  "opencollection": "1.0.0",
  "info": {
    "name": "Runpod REST Billing Openapi.json API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Openapi.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the OpenAPI specification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.runpod.io/v1/openapi.json"
          },
          "docs": "Retrieve the OpenAPI specification"
        }
      ]
    }
  ],
  "bundled": true
}